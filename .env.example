AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
SEARCH_BACKEND=tavily
TAVILY_API_KEY=<tavily-key>
QUESTIONS_PER_SECTION=3
STEP_BUDGET=40
OUTPUT_DIR=output

# Google Drive upload (optional). Create an OAuth "Web" client in Google Cloud,
# enable the Drive API, add redirect URI http://localhost:8000/api/drive/callback
# (and http://127.0.0.1:8000/api/drive/callback), download the client secrets JSON.
GOOGLE_OAUTH_CLIENT_SECRETS=
GDRIVE_TOKEN_PATH=
GDRIVE_FOLDER_NAME=Study Lamp

# Web app login (required to start `explain-web`). Single shared password.
# Generate the hash:  explain-web hash-password
# Generate the key:   python -c "import secrets; print(secrets.token_hex(32))"
STUDYLAMP_PASSWORD_HASH=
STUDYLAMP_SECRET_KEY=
STUDYLAMP_SESSION_DAYS=30
