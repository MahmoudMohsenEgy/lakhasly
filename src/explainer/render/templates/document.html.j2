<!doctype html>
<html dir="rtl" lang="ar">
<head><meta charset="utf-8"><style>{{ css | safe }}</style></head>
<body>
<h1>{{ title }}</h1>
{% for sec in sections %}
  <section>
    <h2>{{ sec.title }}</h2>
    {{ sec.arabic_html | safe }}
    {% for fig in sec.figures %}
      <figure><img src="{{ fig.data_uri }}" alt="{{ fig.alt }}">
        <figcaption>{{ fig.caption_html | safe }}</figcaption></figure>
    {% endfor %}
  </section>
{% endfor %}
{% if questions %}
<section class="quiz"><h2>أسئلة المراجعة</h2>
{% for q in questions %}
  <div class="mcq"><p><strong>{{ q.n }}. {{ q.question | safe }}</strong></p>
    <ol type="A">{% for opt in q.options %}<li>{{ opt | safe }}</li>{% endfor %}</ol></div>
{% endfor %}
</section>
<section class="answer-key"><h2>مفتاح الإجابات</h2>
{% for ans in answers %}<p>{{ ans.n }}. <strong>{{ ans.letter }}</strong> — {{ ans.explanation | safe }}</p>{% endfor %}
</section>
{% endif %}
</body></html>
